{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "src/**",
            "example/**/*.{ts,tsx,js,jsx}",
            "!**/node_modules",
            "!**/lib",
            "!**/nitrogen",
            "!**/android",
            "!**/ios",
            "!**/.expo"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "a11y": {
                "useAltText": "off"
            },
            "complexity": {
                "noForEach": "off"
            },
            "correctness": {
                "noUnusedImports": "warn",
                "useUniqueElementIds": "off"
            },
            "suspicious": {
                "noArrayIndexKey": "off"
            },
            "preset": "recommended"
        }
    },
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        },
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "single"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            ["react", "react-native", "react/**", "react-native/**"],
                            ":PACKAGE:",
                            {
                                "type": true
                            },
                            ":PATH:"
                        ]
                    }
                }
            }
        }
    }
}
