{
    "name": "rn-sak",
    "version": "0.1.0",
    "description": "Swiss Army Knife for React Native projects",
    "main": "./lib/module/index.js",
    "types": "./lib/typescript/src/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.tsx",
            "types": "./lib/typescript/src/index.d.ts",
            "default": "./lib/module/index.js"
        },
        "./rest": {
            "source": "./src/rest/index.ts",
            "types": "./lib/typescript/src/rest/index.d.ts",
            "default": "./lib/module/rest/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "cpp",
        "nitrogen",
        "nitro.json",
        "*.podspec",
        "react-native.config.js",
        "!ios/build",
        "!android/build",
        "!android/gradle",
        "!android/gradlew",
        "!android/gradlew.bat",
        "!android/local.properties",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/.*"
    ],
    "scripts": {
        "example": "pnpm workspace rn-sak-example",
        "clean": "del-cli lib",
        "prepare": "bob build",
        "nitrogen": "nitrogen",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "tsc",
        "test": "jest"
    },
    "keywords": [
        "react-native",
        "ios",
        "android"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vegidio/rn-sak.git"
    },
    "author": "Vinicius Egidio <me@vinicius.io> (https://github.com/vegidio)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vegidio/rn-sak/issues"
    },
    "homepage": "https://github.com/vegidio/rn-sak#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@babel/plugin-proposal-decorators": "^7.29.7",
        "@babel/plugin-transform-class-properties": "^7.29.7",
        "@biomejs/biome": "2.5.0",
        "@jest/globals": "^29.7.0",
        "@react-native/babel-preset": "0.85.0",
        "@react-native/jest-preset": "0.85.0",
        "@tanstack/react-query": "^5.101.0",
        "@types/react": "^19.2.0",
        "del-cli": "^7.0.0",
        "jest": "^29.7.0",
        "nitrogen": "^0.35.9",
        "react": "19.2.0",
        "react-native": "0.83.6",
        "react-native-builder-bob": "^0.42.1",
        "react-native-nitro-modules": "^0.35.9",
        "turbo": "^2.9.16",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@tanstack/react-query": ">=5",
        "react": "*",
        "react-native": "*",
        "react-native-nitro-modules": "^0.35.9"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "custom",
                {
                    "script": "nitrogen",
                    "clean": "nitrogen/"
                }
            ],
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "jest": {
        "preset": "@react-native/jest-preset",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ],
        "transformIgnorePatterns": [
            "node_modules/.pnpm/(?!((jest-)?react-native|@react-native(-community)?)[@+])"
        ]
    },
    "create-react-native-library": {
        "type": "nitro-module",
        "languages": "kotlin-swift",
        "tools": [
            "jest"
        ],
        "version": "0.62.2"
    },
    "dependencies": {
        "axios": "^1.18.0"
    }
}
